# Public HTTPS URL of this service (ngrok / Cloudflare tunnel / deploy URL).
# WhatsApp fetches brochure and cost-sheet PDFs from PUBLIC_BASE_URL/static/...
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Shared secrets
TOOL_SECRET=change-me-tools        # Ringg tools send X-Tool-Secret
WEBHOOK_SECRET=change-me-webhook   # Ringg webhook sends Authorization: Bearer ...
INTAKE_SECRET=change-me-intake     # lead sources / CRM send X-Intake-Secret

# "mock" logs every call, WhatsApp and email to the messages table instead of sending. "live" sends for real.
DELIVERY_MODE=mock

# Ringg (one agent per job; prompts in ringg/agents/)
RINGG_API_KEY=
RINGG_FROM_NUMBER=
RINGG_AGENT_SPEED_TO_LEAD=
RINGG_AGENT_CONCIERGE=
RINGG_AGENT_FEEDBACK=
RINGG_AGENT_REACTIVATION=

# Calling rules (IST)
CALL_WINDOW_START=10
CALL_WINDOW_END=19
MAX_CALLS_PER_DAY=3
MAX_CALLS_PER_WEEK=6
SCHEDULER_INTERVAL_SECONDS=5

# WhatsApp Cloud API (Meta). Templates in ringg/whatsapp_templates.md must be approved first.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=change-me-verify
WA_API_VERSION=v21.0
WA_TEMPLATE_LANG=en

# SMTP (Gmail app password, Amazon SES SMTP, Resend SMTP, Zoho...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Skyline Homes <sales@example.com>
SALES_TEAM_EMAIL=sales-team@example.com

# Persona evals (evals/run.py). The SDK also picks up an `ant auth login` profile.
ANTHROPIC_API_KEY=
EVAL_MODEL=claude-opus-5-5

DB_PATH=data/app.db
